PORT=3000
# Use a long unique password (at least 16 characters); admin remains disabled without it.
ADMIN_PASSWORD=
# Optional limited role: can review submissions but cannot publish configuration.
REVIEWER_PASSWORD=
# Production must use HTTPS; enables Secure cookies.
NODE_ENV=development
# Optional server-side educational assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Render routes traffic through one trusted reverse proxy. Leave unset locally.
# TRUST_PROXY_HOPS=1
